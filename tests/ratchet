#!/bin/bash
#
#  Regression ratchet for the Python port of SCBI.
#
#  Runs each test driver separately with SCBI_IMPL=python and compares the
#  result with python-pass.txt (the list of drivers known to pass):
#
#    - a listed driver that fails is a regression: exit status 1
#    - a newly passing driver is appended to python-pass.txt
#      (unless --no-update is given)
#
#  usage: ratchet [--no-update] [--impl=bash|python] [testNNN...]
#
#  Logs of each driver are kept in .ratchet/<test>.log
#

cd "$(dirname "$0")"

PASS_FILE=python-pass.txt
LOG_DIR=.ratchet
UPDATE=yes
IMPL=python
TESTS=()

for arg in "$@"; do
    case $arg in
        --no-update) UPDATE=no ;;
        --impl=*)    IMPL=${arg#--impl=} ;;
        -*)          echo "usage: $0 [--no-update] [--impl=bash|python] [testNNN...]"
                     exit 2 ;;
        *)           TESTS+=( "$arg" ) ;;
    esac
done

if [[ ${#TESTS[@]} == 0 ]]; then
    TESTS=( $(cd drivers; ls test???) )
fi

touch $PASS_FILE
rm -fr $LOG_DIR
mkdir -p $LOG_DIR

PASSED=()
FAILED=()
REGRESSIONS=()
NEW=()

for t in "${TESTS[@]}"; do
    SCBI_IMPL=$IMPL ./run $t > $LOG_DIR/$t.log 2>&1
    if [[ $? == 0 ]]; then
        PASSED+=( $t )
        grep -qx $t $PASS_FILE || NEW+=( $t )
        echo "pass  $t"
    else
        FAILED+=( $t )
        if grep -qx $t $PASS_FILE; then
            REGRESSIONS+=( $t )
            echo "FAIL  $t  (regression, see $LOG_DIR/$t.log)"
        else
            echo "fail  $t"
        fi
    fi
done

echo
echo "impl=$IMPL passed=${#PASSED[@]} failed=${#FAILED[@]}" \
     "new=${#NEW[@]} regressions=${#REGRESSIONS[@]}"

if [[ $IMPL == python ]] && [[ $UPDATE == yes ]] && [[ ${#NEW[@]} -gt 0 ]]; then
    printf "%s\n" "${NEW[@]}" >> $PASS_FILE
    sort -u -o $PASS_FILE $PASS_FILE
    echo "added to $PASS_FILE: ${NEW[*]}"
fi

if [[ ${#REGRESSIONS[@]} -gt 0 ]]; then
    echo "regressions: ${REGRESSIONS[*]}"
    exit 1
fi

exit 0
