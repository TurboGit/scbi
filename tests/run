#!/bin/bash

export LANG=C

function clean-up-osht-output()
{
    local PWD2=${PWD//$HOME/\~}
    sed -i 's,^[0-9/]* [0-9:]* :,xxxx/xx/xx xx:xx:xx :,g;${/^$/d;};s/squid-cgi [0-9\.]*/squid-cgi v.vv/g;s,(....................),(xxxxxxxxxxxxxxxxxxxx),g' \
        ${OSHT_STDIO}
    sed -i "s,$PWD,<pwd>,g;s,$PWD2,<pwd>,g;" ${OSHT_STDIO}
    #  how to reproduce a failing step: a Bash script (legacy hooks) or a
    #  replay file (hooks in the command language)
    sed -i -E 's,\(FAILED\) (bash|scbi replay) (.*\.cmd)$,(FAILED) <reproduce> \2,;s,\(FAILED\) use (bash -x|--trace) option for debug$,(FAILED) use <debug> option for debug,' \
        ${OSHT_STDIO}
}

function no-osht-output-version()
{
    sed -E -i 's,:[0-9]*\.[0-9]*\.?[0-9]*,:x.x,g' ${OSHT_STDIO}
}

function sort-osht-output()
{
    cat ${OSHT_STDIO} | sort > xout
    mv xout ${OSHT_STDIO}
}

function trim-osht-output()
{
    sed -i 's/  *$//' ${OSHT_STDIO}
}

function sort-osht-output-n-first-lines()
{
    local N=$1

    #  Make sure we clean the time-stamp to not be sorting based on it
    clean-up-osht-output

    head -$N ${OSHT_STDIO} | sort > xout
    sed -i "1,${N}d" ${OSHT_STDIO}
    cat ${OSHT_STDIO} >> xout
    mv xout ${OSHT_STDIO}
}

function sort-osht-output-but-n-lines()
{
    local N=$1

    head -$N ${OSHT_STDIO} > xout
    sed -i "${N}d" ${OSHT_STDIO}
    sort ${OSHT_STDIO} >> xout
    mv xout ${OSHT_STDIO}
}

function sort-osht-output-but-first-line()
{
    sort-osht-output-but-n-lines 1
}

function clean-up-osht-input()
{
    sed 's,^[0-9/]* [0-9:]* :,xxxx/xx/xx xx:xx:xx :,g;${/^$/d;}'
    sed -i "/_[_]*TRACE:/d" ${OSHT_STDIO}
}

function CLEAN-DIFF()
{
    clean-up-osht-output
    trim-osht-output
    cat - | clean-up-osht-input | \
DIFF
}

export ROOTDIR=$PWD

function run-test()
{
    local TEST=$1
    local EXP=$2

    cp drivers/$TEST .
    source ./$TEST
    cd $ROOTDIR
    rm -f $TEST
}

./clean

export CDPATH=

rm -f scripts.d/.store

# the packages of the distributions
cp ../scripts.d/.pkgs-* scripts.d/

export PATH="$PWD:$PATH"

# The Python driver (src/scbi). With SCBI_TESTSUITE set it does not load
# $HOME/.scbi, uses the rsync checksum mode and logs the sync messages
# with ilog; the defaults below are the testsuite settings (SCBI_SVN_REPO
# and SCBI_HG_REPO kept empty, TODAY empty: logs directly in .logs).
export SCBI_TESTSUITE=yes
export SCBI_ROOT=$PWD/.root
export SCBI_ARCHIVES=$SCBI_ROOT/.archives
export SCBI_PATCH=$SCBI_ROOT/.patches
export SCBI_GIT_REPO=$SCBI_ROOT/git
export SCBI_SVN_REPO= SCBI_HG_REPO= TODAY=
cat > scbi <<EOF
#!/bin/bash
SCBI_ARGV0="\$0" PYTHONPATH=$PWD/../src\${PYTHONPATH:+:\$PYTHONPATH} exec python3 -m scbi "\$@"
EOF
chmod +x scbi

mkdir -p .root/.patches

# kill mail for testing
export SCBI_EMAIL_NOTIFICATION=no

# be sure the global install directory exists
mkdir -p $PWD/.root/builds/install

# create the log dirs
mkdir -p $PWD/logs

. osht

cd drivers
if [ -z "$1" ]; then
    TESTS=( test??? )
else
    TESTS=( $* )
fi
cd ..

#  The plan is only known when running the whole testsuite
[ -z "$1" ] && PLAN 1386

export SCBI_CACHE_DIR="no"

for file in ${TESTS[*]}; do
    cd $ROOTDIR
    export TESTREPOS=$ROOTDIR/.root/repos

    # copy/reset patches each time as some drivers
    # are changing them for testing purpose.
    cp .root/repos/*.patch .root/.patches/

    # clean build directory to ensure each run are independent
    rm -fr .root/builds* $SCBI_CACHE_DIR

    export SCBI_CACHE_DIR="no"

    bfile=$(basename $file)

    # set cache for modules using it
    case $bfile in
        test158|test159|test160|test161)
            export SCBI_CACHE_DIR=$ROOTDIR/.root/.cache
            rm -fr $SCBI_CACHE_DIR
            ;;
        *)
            ;;
    esac

    echo "========== $bfile"
    run-test $bfile expected/$bfile.exp
done
