
#  The run option of an ini section runs the command in the environment of
#  the modules (as scbi shell --run=cmd)

export SCBI_INI_FILE=$ROOTDIR/.scbiini

cat <<EOF > $SCBI_INI_FILE
[rundt]
   modules = test2
   run = echo ran with --multi --fr
EOF

RUNS ./scbi --ini=rundt

CLEAN-DIFF <<EOF
ran with --multi --fr
EOF

unset SCBI_INI_FILE
