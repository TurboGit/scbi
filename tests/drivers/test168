#  the inherited ones

RUNS ./scbi inh-app-hooks

CLEAN-DIFF <<EOF
xxxx/xx/xx xx:xx:xx : Building inh-app-hooks [default] (n/a)
xxxx/xx/xx xx:xx:xx : native x86_64-linux-gnu
xxxx/xx/xx xx:xx:xx : steps: setup config build install wrapup
xxxx/xx/xx xx:xx:xx : no sources (vcs or tar)
xxxx/xx/xx xx:xx:xx : trigger: not yet built
xxxx/xx/xx xx:xx:xx : config starting
xxxx/xx/xx xx:xx:xx : config completed
xxxx/xx/xx xx:xx:xx : install starting
xxxx/xx/xx xx:xx:xx : install completed
xxxx/xx/xx xx:xx:xx : End Building inh-app-hooks [default] (n/a)
EOF

LDIR=.root/builds/inh-app-hooks/build/logs

RUNS grep -h '^@@@' $LDIR/config.log $LDIR/install.log

DIFF <<EOF
@@@ CONFIG
@@@ GENERIC-inh-specific
@@@ SHARED-inh-specific
@@@ INSTALL-inh-specific
EOF

