@alias p-gnat use c-sandbox
@alias p-gnatmem use c-sandbox
# On GNU/Linux we use the iconv from libc
@on linux,native use c-libiconv:skip
p-gdb:gdb-head
# Use 21 as this is the version compatible with c-llvm-bindings
c-libclang:llvmorg-21.1.8
c-gpr2:main
c-readline:#6.2
c-gnatcov/c
c-gtkada:main

@for c-darktable use c-libavif/auto:v0.10.1
c-darktable/all
c-libavif/auto
c-libiconv:#1.18
c-gmp:#6.2.1
c-cmake/auto:v3.18.4
c-exiv2/auto:v0.27.5
c-libopenjpeg/auto:2.5.4
