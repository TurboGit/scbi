diff --git a/Makefile b/Makefile
index 29b874e..4490fc1 100644
--- a/Makefile
+++ b/Makefile
@@ -168,7 +168,18 @@ build-gps-support: build-lib-native
 
 build-native: build-tools-native build-gps-support
 
-build-tools-cross: build-lib-cross
+#  cross build: the templates are generated by awsres, a native tool: the
+#  one of the native build of this module (built first), in the build tree of
+#  the same module for the host
+NATIVE_AWSRES ?= $(CURDIR)/../../$(shell gcc -dumpmachine)-default/install/bin/awsres
+
+gen-templates-cross:
+	test -x $(NATIVE_AWSRES) || { echo "$(NATIVE_AWSRES) not found: build the native tools first"; exit 1; }
+	mkdir -p $(CMN_DIR)/src
+	$(NATIVE_AWSRES) -r wsdl2aws_templates -o $(CMN_DIR)/src \
+	  tools/wsdl2aws-templates/*.tad[sb] tools/wsdl2aws-templates/*.macros
+
+build-tools-cross: gen-templates-cross build-lib-cross
 	$(GPRBUILD) -p --target=$(TARGET) $(GPROPTS) \
 		$(GPR_STATIC) tools/tools.gpr
 
@@ -188,7 +199,7 @@ gen-templates: build-awsres-tool-native force
 build-cross: build-tools-cross
 
 ifeq (${IS_CROSS}, true)
-build: gen-templates build-cross
+build: build-cross
 else
 build: gen-templates build-native
 endif
