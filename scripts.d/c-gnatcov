
function c-gnatcov-vcs()
{
    echo default
    echo none
    echo git
    echo https://github.com/AdaCore/gnatcoverage.git
}

function c-gnatcov-out-of-tree()
{
    echo false
}

function c-gnatcov-build-depends()
{
    echo p-gnat
    echo c-gprbuild
}

function c-gnatcov-common-depends()
{
    echo p-gnat-util
    echo c-binutils
    echo c-gnatcoll-core
    echo c-libadalang
    echo c-gpr2-lib
    echo c-templates-parser
    echo c-stable-sloc
}

function c-gnatcov-c-depends()
{
    echo c-llvm-bindings
}

function c-gnatcov-env()
{
    local PREFIX=$1
    local TARGET=$2
    local VARIANT=$3

    add-to-var PATH $PREFIX/bin
}

function c-gnatcov-build-env()
{
    local PREFIX=$1
    local TARGET=$2
    local VARIANT=$3

    #  Make sure the g++ compiler is first on the PATH as we don't
    #  want the clang++ (from c-libclang) to be used.
    prepend-to-var PATH $SCBI_PREFIX/bin
}

function c-gnatcov-build()
{
    local PREFIX=$1
    local TARGET=$2
    local VARIANT=$3

    cd tools/gnatcov &&
        make LIBRARY_TYPE=static C_SUPPORT=True \
             PROCESSORS=$SCBI_JOBS bin
}

function c-gnatcov-install()
{
    local PREFIX=$1
    local TARGET=$2
    local VARIANT=$3

    cd tools/gnatcov &&
        make PREFIX=$PREFIX LIBRARY_TYPE=static C_SUPPORT=True install
}
