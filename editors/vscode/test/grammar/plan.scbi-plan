# SYNTAX TEST "source.scbi-plan" "SCBI build plans"

# a comment line
# <------------------ comment.line.number-sign.scbi-plan

@load base
# <----- keyword.other.directive.scbi-plan
#     ^^^^ entity.name.plan.scbi-plan

  @set VER = v2.1   # shared version
# ^^^^ keyword.other.directive.scbi-plan
#      ^^^ variable.other.definition.scbi-plan
#          ^ keyword.operator.assignment.scbi-plan
#            ^^^^ string.unquoted.value.scbi-plan
#                   ^^^^^^^^^^^^^^^^ comment.line.number-sign.scbi-plan

  @ref lib2 as lib1 version v/[0-9].[0-9]/
# ^^^^ keyword.other.directive.scbi-plan
#      ^^^^ entity.name.module.scbi-plan
#           ^^ keyword.other.as.scbi-plan
#              ^^^^ entity.name.module.scbi-plan
#                   ^^^^^^^ keyword.other.version.scbi-plan
#                           ^^^^^^^^^^^^^^^ string.regexp.scbi-plan

  @ref lib1:v2 as libVR
#          ^ punctuation.separator.version.scbi-plan
#           ^^ string.unquoted.version.scbi-plan
#              ^^ keyword.other.as.scbi-plan

  @on deb,10.1 use os@-mylualib:skip
# ^^^ keyword.other.directive.scbi-plan
#     ^^^ constant.other.condition.scbi-plan
#        ^ punctuation.separator.condition.scbi-plan
#         ^^^^ constant.other.condition.scbi-plan
#              ^^^ keyword.other.use.scbi-plan
#                  ^^^^ support.type.os-package.scbi-plan
#                      ^^^^^^^^ entity.name.module.scbi-plan
#                               ^^^^ constant.language.version.scbi-plan

  @for c-darktable use c-exiv2/auto:v0.27.5
# ^^^^ keyword.other.directive.scbi-plan
#      ^^^^^^^^^^^ entity.other.for-module.scbi-plan
#                  ^^^ keyword.other.use.scbi-plan
#                      ^^^^^^^ entity.name.module.scbi-plan
#                              ^^^^ support.constant.variant.scbi-plan
#                                   ^^^^^^^ string.unquoted.version.scbi-plan

  @alias p-gnat use c-sandbox
# ^^^^^^ keyword.other.directive.scbi-plan
#        ^^^^^^ entity.name.module.scbi-plan
#               ^^^ keyword.other.use.scbi-plan
#                   ^^^^^^^^^ entity.name.module.scbi-plan

  @bogus x
# ^^^^^^ invalid.illegal.directive.scbi-plan

  lcms2/fast.mpi:#2.13   # native too recent
# ^^^^^ entity.name.module.scbi-plan
#      ^ punctuation.separator.variant.scbi-plan
#       ^^^^ entity.name.tag.variant.scbi-plan
#           ^ punctuation.separator.variant.scbi-plan
#            ^^^ entity.name.tag.variant.scbi-plan
#               ^ punctuation.separator.version.scbi-plan
#                ^ punctuation.definition.archive.scbi-plan
#                 ^^^^ string.unquoted.version.scbi-plan
#                        ^^^^^^^^^^^^^^^^^^^ comment.line.number-sign.scbi-plan

  libVR/variant-no-patch:dev
#       ^^^^^^^^^^^^^^^^ entity.name.tag.variant.scbi-plan
#                        ^^^ constant.language.version.scbi-plan

  libR:develop
#      ^^^^^^^ string.unquoted.version.scbi-plan
#      ^^^^^^^ - constant.language.version.scbi-plan

  mainlib=lib1/titi
# ^^^^^^^ entity.other.for-module.scbi-plan
#        ^ punctuation.separator.for-module.scbi-plan
#         ^^^^ entity.name.module.scbi-plan
#              ^^^^ entity.name.tag.variant.scbi-plan

  s-paraview/mingw.gdal:#$PV_VERSION
#                        ^^^^^^^^^^^ variable.other.scbi-plan

  [ /= deb,9 deb,11
# ^ punctuation.section.group.begin.scbi-plan
#   ^^ keyword.operator.comparison.scbi-plan
#      ^^^ constant.other.condition.scbi-plan
#         ^ punctuation.separator.condition.scbi-plan
#          ^ constant.other.condition.scbi-plan
#            ^^^ constant.other.condition.scbi-plan
#                ^^ constant.other.condition.scbi-plan
      modF
#     ^^^^ entity.name.module.scbi-plan
  ] /+2.four:${VER}
# ^ punctuation.section.group.end.scbi-plan
#    ^ keyword.operator.variant.scbi-plan
#     ^ entity.name.tag.variant.scbi-plan
#       ^^^^ entity.name.tag.variant.scbi-plan
#           ^ punctuation.separator.version.scbi-plan
#            ^^^^^^ variable.other.scbi-plan

  [ = mpi
#     ^^^ constant.other.condition.scbi-plan
  ] /speed
#    ^^^^^ entity.name.tag.variant.scbi-plan

  ] :skip e-smesh
#    ^^^^ constant.language.version.scbi-plan
#         ^^^^^^^ invalid.illegal.ignored.scbi-plan
