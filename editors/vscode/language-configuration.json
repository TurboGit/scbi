{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    }
  ],
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "wordPattern": "(\\$\\{?)?[\\w.+@-]+\\}?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*\\[",
    "decreaseIndentPattern": "^\\s*\\]"
  }
}
