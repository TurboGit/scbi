{
  "name": "scbi",
  "displayName": "SCBI",
  "description": "SCBI (Source Code Build Infrastructure): lint, format and complete the YAML plug-ins; build or run the sections of the .scbi ini files.",
  "version": "0.1.0",
  "publisher": "turbogit",
  "license": "GPL-3.0-or-later",
  "icon": "images/icon.png",
  "homepage": "https://github.com/TurboGit/scbi/tree/master/editors/vscode#readme",
  "bugs": {
    "url": "https://github.com/TurboGit/scbi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TurboGit/scbi",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "workspaceContains:.scbi"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scbi.lint",
        "title": "Lint Plug-in",
        "category": "SCBI"
      },
      {
        "command": "scbi.format",
        "title": "Format Plug-in",
        "category": "SCBI"
      },
      {
        "command": "scbi.selectSection",
        "title": "Select Section",
        "category": "SCBI"
      },
      {
        "command": "scbi.runSection",
        "title": "Build or Run the Selected Section",
        "category": "SCBI",
        "icon": "$(play)"
      }
    ],
    "configuration": {
      "title": "SCBI",
      "properties": {
        "scbi.path": {
          "type": "string",
          "default": "scbi",
          "description": "The scbi command (a name found in PATH or a full path)."
        },
        "scbi.lint.mode": {
          "type": "string",
          "enum": [
            "onType",
            "onSave",
            "off"
          ],
          "default": "onType",
          "description": "When the plug-ins are linted: while typing (after a short delay), on save, or never (command only)."
        },
        "scbi.pluginPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/scripts.d/[!.]*.yaml"
          ],
          "description": "Glob patterns of the SCBI plug-ins. A YAML file with a top-level 'plugin:' key is a plug-in too."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "scbi",
        "required": [
          "section"
        ],
        "properties": {
          "section": {
            "type": "string",
            "description": "The section of the ini files (scbi --ini=<section>)."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "More options of scbi (e.g. --force)."
          }
        }
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "scbi.shell",
          "title": "SCBI Shell",
          "icon": "tools"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "tsc -p . && vsce package",
    "vscode:prepublish": "tsc -p .",
    "smoke": "tsc -p . && node out/test/smoke/run.js"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "@types/vscode": "~1.90.0",
    "typescript": "~5.9.3",
    "@vscode/vsce": "~3.9.2",
    "@vscode/test-electron": "~3.1.0"
  },
  "keywords": [
    "scbi",
    "build",
    "plug-in",
    "yaml",
    "lint"
  ]
}
