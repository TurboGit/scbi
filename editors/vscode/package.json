{
  "name": "scbi",
  "displayName": "SCBI",
  "description": "SCBI (Source Code Build Infrastructure): lint and format the YAML plug-ins.",
  "version": "0.1.0",
  "publisher": "scbi",
  "repository": {
    "type": "git",
    "url": "https://github.com/TurboGit/scbi"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scbi.lint",
        "title": "Lint Plug-in",
        "category": "SCBI"
      },
      {
        "command": "scbi.format",
        "title": "Format Plug-in",
        "category": "SCBI"
      }
    ],
    "configuration": {
      "title": "SCBI",
      "properties": {
        "scbi.path": {
          "type": "string",
          "default": "scbi",
          "description": "The scbi command (a name found in PATH or a full path)."
        },
        "scbi.lint.mode": {
          "type": "string",
          "enum": ["onType", "onSave", "off"],
          "default": "onType",
          "description": "When the plug-ins are linted: while typing (after a short delay), on save, or never (command only)."
        },
        "scbi.pluginPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/scripts.d/[!.]*.yaml"],
          "description": "Glob patterns of the SCBI plug-ins. A YAML file with a top-level 'plugin:' key is a plug-in too."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "@types/vscode": "~1.90.0",
    "typescript": "~5.9.3"
  }
}
