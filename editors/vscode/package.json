{
  "name": "scbi",
  "displayName": "SCBI",
  "description": "SCBI (Source Code Build Infrastructure): lint, format and complete the YAML plug-ins; highlight and complete the build plans; build or run the sections of the .scbi ini files.",
  "version": "0.3.0",
  "publisher": "turbogit",
  "license": "GPL-3.0-or-later",
  "icon": "images/icon.png",
  "homepage": "https://github.com/TurboGit/scbi/tree/master/editors/vscode#readme",
  "bugs": {
    "url": "https://github.com/TurboGit/scbi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TurboGit/scbi",
    "directory": "editors/vscode"
  },
  "keywords": [
    "scbi",
    "build",
    "plug-in",
    "build plan",
    "yaml",
    "lint"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:scbi-plan",
    "workspaceContains:.scbi"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scbi.lint",
        "title": "Lint Plug-in",
        "category": "SCBI"
      },
      {
        "command": "scbi.format",
        "title": "Format Plug-in",
        "category": "SCBI"
      },
      {
        "command": "scbi.selectSection",
        "title": "Select Section",
        "category": "SCBI"
      },
      {
        "command": "scbi.runSection",
        "title": "Build or Run the Selected Section",
        "category": "SCBI",
        "icon": "$(play)"
      }
    ],
    "configuration": {
      "title": "SCBI",
      "properties": {
        "scbi.path": {
          "type": "string",
          "default": "scbi",
          "description": "The scbi command (a name found in PATH or a full path)."
        },
        "scbi.lint.mode": {
          "type": "string",
          "enum": [
            "onType",
            "onSave",
            "off"
          ],
          "default": "onType",
          "description": "When the plug-ins are linted: while typing (after a short delay), on save, or never (command only)."
        },
        "scbi.pluginPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/scripts.d/[!.]*.yaml"
          ],
          "description": "Glob patterns of the SCBI plug-ins. A YAML file with a top-level 'plugin:' key is a plug-in too."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "scbi",
        "required": [
          "section"
        ],
        "properties": {
          "section": {
            "type": "string",
            "description": "The section of the ini files (scbi --ini=<section>)."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "More options of scbi (e.g. --force)."
          }
        }
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "scbi.shell",
          "title": "SCBI Shell",
          "icon": "tools"
        }
      ]
    },
    "languages": [
      {
        "id": "scbi-plan",
        "aliases": [
          "SCBI Plan",
          "scbi-plan"
        ],
        "filenamePatterns": [
          ".plan-*",
          ".scbi-plan-*"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scbi-plan",
        "scopeName": "source.scbi-plan",
        "path": "./syntaxes/scbi-plan.tmLanguage.json"
      },
      {
        "scopeName": "source.scbi-commands",
        "path": "./syntaxes/scbi-commands.tmLanguage.json"
      },
      {
        "scopeName": "scbi.yaml-block.injection",
        "path": "./syntaxes/scbi-yaml-block.injection.json",
        "injectTo": [
          "source.yaml"
        ]
      },
      {
        "scopeName": "scbi.yaml-plain.injection",
        "path": "./syntaxes/scbi-yaml-plain.injection.json",
        "injectTo": [
          "source.yaml"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js && vscode-tmgrammar-test -g test/grammar/yaml/yaml.tmLanguage.json -g test/grammar/yaml/yaml-1.0.tmLanguage.json -g test/grammar/yaml/yaml-1.1.tmLanguage.json -g test/grammar/yaml/yaml-1.2.tmLanguage.json -g test/grammar/yaml/yaml-1.3.tmLanguage.json -g test/grammar/yaml/yaml-embedded.tmLanguage.json \"test/grammar/*.scbi-plan\" \"test/grammar/*.yaml\" && vscode-tmgrammar-test -g test/grammar-redhat/yaml.tmLanguage.json -g syntaxes/scbi-commands.tmLanguage.json -g syntaxes/scbi-yaml-block.injection.json -g syntaxes/scbi-yaml-plain.injection.json \"test/grammar-redhat/*.yaml\"",
    "package": "tsc -p . && vsce package",
    "vscode:prepublish": "tsc -p .",
    "smoke": "tsc -p . && node out/test/smoke/run.js"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "~3.1.0",
    "@vscode/vsce": "~3.9.2",
    "typescript": "~5.9.3",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
